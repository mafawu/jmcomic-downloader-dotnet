<Project Sdk="Microsoft.NET.Sdk">

  <!--
    说明：不使用 ProjectReference 引用 JmComic.App——
    本机 SDK 缺少 workload locator 时，带项目引用的新项目首次构建会失败（MSB4276）。
    改用 DLL 引用：先构建 JmComic.App，再引用其产物；XAML 资源通过 pack URI 从该程序集加载。
  -->
  <ItemGroup>
    <Reference Include="JmComic.App">
      <HintPath>..\JmComic.App\bin\$(Configuration)\JmComic.App.dll</HintPath>
    </Reference>
    <Reference Include="JmComic.Core">
      <HintPath>..\JmComic.Core\bin\$(Configuration)\JmComic.Core.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <!-- JmComic.Core 的传递依赖（DLL 引用不会自动复制，需显式声明） -->
    <PackageReference Include="AngleSharp" Version="1.7.1" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Copymanga.App</RootNamespace>
    <AssemblyName>Copymanga.App</AssemblyName>
  </PropertyGroup>

</Project>
