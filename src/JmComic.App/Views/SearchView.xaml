<UserControl x:Class="JmComic.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JmComic.App.Controls">
    <UserControl.Resources>
        <!-- 提示态：图标 + 主文案 + 副文案 -->
        <DataTemplate x:Key="HintStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="20"
                        Background="{DynamicResource PrimarySubtleBrush}">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="输入关键词，开始探索" FontSize="15" FontWeight="SemiBold"
                           Margin="0,18,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="支持漫画名称 / ID / 作者搜索，回车或点击搜索按钮" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 加载态：骨架屏（3 张占位卡片） -->
        <DataTemplate x:Key="LoadingStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <Border Width="168" Height="222" CornerRadius="14"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Border Width="168" Height="222" CornerRadius="14"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <Border Width="168" Height="222" CornerRadius="14"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="搜索中…" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 空态：图标 + 文案 + 重试 -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="18"
                        Background="{DynamicResource HoverBgBrush}">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="没有找到相关漫画" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="换个关键词或排序方式再试试吧" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PillGhostButtonStyle}" Content="重新搜索"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Click="EmptyRetryButton_Click" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ResultStateTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AutoColumnsUniformGrid ItemSlotWidth="182" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:AlbumCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>

        <Style x:Key="StateHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource HintStateTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Loading">
                    <Setter Property="ContentTemplate" Value="{StaticResource LoadingStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Empty">
                    <Setter Property="ContentTemplate" Value="{StaticResource EmptyStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Result">
                    <Setter Property="ContentTemplate" Value="{StaticResource ResultStateTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Margin="0,0,10,0">
                    <TextBox x:Name="KeywordBox" Style="{StaticResource ModernTextBoxStyle}"
                             MinWidth="120" Padding="34,7,30,7"
                             KeyDown="KeywordBox_KeyDown"
                             VerticalContentAlignment="Center"
                             ToolTip="输入漫画名称 / ID / 作者搜索" />
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               IsHitTestVisible="False" Margin="12,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Text="输入漫画名称 / ID / 作者搜索" FontSize="12.5"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               IsHitTestVisible="False" Margin="34,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=KeywordBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=KeywordBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="ClearKeywordButton" Style="{StaticResource IconButtonStyle}"
                            ToolTip="清除" Click="ClearKeywordButton_Click"
                            HorizontalAlignment="Right" Margin="0,0,4,0"
                            VerticalAlignment="Center" Padding="6" FontSize="12">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </Grid>

                <ComboBox x:Name="SortBox" Grid.Column="1" Width="130"
                          SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="最新发布" Tag="Latest" />
                    <ComboBoxItem Content="最多观看" Tag="View" />
                    <ComboBoxItem Content="图片最多" Tag="Picture" />
                    <ComboBoxItem Content="最多点赞" Tag="Like" />
                </ComboBox>
                <Button Grid.Column="2" Margin="10,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="搜索" Click="SearchButton_Click" />
            </Grid>
        </Border>

        <!-- 内容区（按状态切换模板） -->
        <ContentControl Grid.Row="1" Style="{StaticResource StateHostStyle}" />

        <!-- 分页 -->
        <StackPanel x:Name="PagingPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="999" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource PaginationButtonStyle}"
                            ToolTip="上一页" Click="PrevButton_Click">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                    <Border Style="{StaticResource CountBadgeStyle}" Margin="4,0"
                            MinWidth="84">
                        <TextBlock x:Name="PageText" FontSize="12.5"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Button x:Name="NextButton" Style="{StaticResource PaginationButtonStyle}"
                            ToolTip="下一页" Click="NextButton_Click">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>