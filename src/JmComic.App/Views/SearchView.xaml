<controls:CardGridViewBase x:Class="JmComic.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JmComic.App.Controls">
    <UserControl.Resources>
        <!-- 提示态：图标 + 主文案 + 副文案 -->
        <DataTemplate x:Key="HintStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="26"
                        Background="{DynamicResource PrimarySubtleBrush}">
                    <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="输入关键词，开始探索" FontSize="16" FontWeight="SemiBold"
                           Margin="0,20,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="支持漫画名称 / ID / 作者搜索，回车或点击搜索按钮" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 加载态：骨架屏（3 张占位卡片） -->
        <DataTemplate x:Key="LoadingStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <Border Width="168" Height="222" CornerRadius="20"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Border Width="168" Height="222" CornerRadius="20"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <Border Width="168" Height="222" CornerRadius="20"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="搜索中…" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 空态：图标 + 文案 + 重试 -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="24"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconDocument}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="没有找到相关漫画" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="换个关键词再试试吧" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PillGhostButtonStyle}" Content="重新搜索"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Click="EmptyRetryButton_Click" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ResultStateTemplate">
            <controls:VirtualizedCardGrid ItemsSource="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <controls:VirtualizedCardGrid.ItemTemplate>
                    <DataTemplate>
                        <controls:AlbumCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                    </DataTemplate>
                </controls:VirtualizedCardGrid.ItemTemplate>
            </controls:VirtualizedCardGrid>
        </DataTemplate>

                <!-- 来源筛选 Tab 胶囊（统一 28高10圆角描边，与分类页胶囊一致） -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" BorderThickness="0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterMultiTabStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterTabStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="StateHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource HintStateTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Loading">
                    <Setter Property="ContentTemplate" Value="{StaticResource LoadingStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Empty">
                    <Setter Property="ContentTemplate" Value="{StaticResource EmptyStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Result">
                    <Setter Property="ContentTemplate" Value="{StaticResource ResultStateTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 搜索栏：关键词 + 来源筛选 Tab -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SearchFieldBd" Height="42" CornerRadius="10"
                            Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Margin="0,0,10,0" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=SearchFieldBd}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=KeywordBox}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="KeywordBox" Style="{StaticResource SearchTextBoxStyle}"
                                         MinWidth="120"
                                         KeyDown="KeywordBox_KeyDown" GotFocus="KeywordBox_GotFocus" LostFocus="KeywordBox_LostFocus" TextChanged="KeywordBox_TextChanged"
                                         VerticalContentAlignment="Center" ToolTip="输入漫画名称 / ID / 作者搜索" />
                                <TextBlock x:Name="KeywordPlaceholder" Text="输入漫画名称 / ID / 作者搜索" FontSize="12.5" Foreground="{DynamicResource TextDisabledBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
                            </Grid>
                            <Button x:Name="ClearKeywordButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" ToolTip="清除" Click="ClearKeywordButton_Click" VerticalAlignment="Center" Margin="4,0,6,0" Padding="0" Width="28" Height="28">
                                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource HoverBgBrush}">
                                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:CardSizeSlider Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center" />
                        <Button Margin="12,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Height="42" MinWidth="96" Padding="0" Click="SearchButton_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconSearch}" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="搜索" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <WrapPanel x:Name="SourceTabs" Orientation="Horizontal" Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- 内容区（按状态切换模板） -->
        <ContentControl Grid.Row="1" Style="{StaticResource StateHostStyle}" />

        <!-- 分页 -->
        <StackPanel x:Name="PagingPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
            <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="999" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource PaginationButtonStyle}"
                            ToolTip="上一页" Click="PrevButton_Click">
                        <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                    <Border Style="{StaticResource CountBadgeStyle}" Margin="4,0"
                            MinWidth="84">
                        <TextBlock x:Name="PageText" FontSize="12.5"
                                   Foreground="{DynamicResource PrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Button x:Name="NextButton" Style="{StaticResource PaginationButtonStyle}"
                            ToolTip="下一页" Click="NextButton_Click">
                        <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</controls:CardGridViewBase>


