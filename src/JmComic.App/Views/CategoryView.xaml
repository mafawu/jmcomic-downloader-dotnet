<controls:CardGridViewBase x:Class="JmComic.App.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:JmComic.App.Views"
             xmlns:controls="clr-namespace:JmComic.App.Controls">
    <UserControl.Resources>
        <!-- 提示态 -->
        <DataTemplate x:Key="HintStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="26"
                        Background="{DynamicResource PrimarySubtleBrush}">
                    <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="点击左侧分类或标签开始浏览" FontSize="15" FontWeight="SemiBold"
                           Margin="0,18,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="分类 + 标签 + 排序组合筛选，结果更精准" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 加载态：骨架屏 -->
        <DataTemplate x:Key="LoadingStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,14,0">
                        <Border Width="168" Height="222" CornerRadius="20"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <Border Width="168" Height="222" CornerRadius="20"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                    <StackPanel>
                        <Border Width="168" Height="222" CornerRadius="20"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="13" CornerRadius="6" Margin="0,10,40,0"
                                Background="{DynamicResource SkeletonBrush}" />
                        <Border Height="10" CornerRadius="5" Margin="0,6,90,0"
                                Background="{DynamicResource SkeletonBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="加载中…" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 空态 -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="24"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconDocument}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="没有找到相关漫画" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="换个关键词、标签或分类再试试吧" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PillGhostButtonStyle}" Content="重新搜索"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Click="EmptyRetryButton_Click" />
            </StackPanel>
        </DataTemplate>

        <!-- 结果态：卡片网格（虚拟化：只实例化可视行） -->
        <DataTemplate x:Key="ResultStateTemplate">
            <controls:VirtualizedCardGrid ItemsSource="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" DesiredColumns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <controls:VirtualizedCardGrid.ItemTemplate>
                    <DataTemplate>
                        <controls:AlbumCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                    </DataTemplate>
                </controls:VirtualizedCardGrid.ItemTemplate>
            </controls:VirtualizedCardGrid>
        </DataTemplate>

        <Style x:Key="StateHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource HintStateTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Loading">
                    <Setter Property="ContentTemplate" Value="{StaticResource LoadingStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Empty">
                    <Setter Property="ContentTemplate" Value="{StaticResource EmptyStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Result">
                    <Setter Property="ContentTemplate" Value="{StaticResource ResultStateTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 侧栏分类胶囊（RadioButton，选中高亮，同一 GroupName 互斥） -->
        <Style x:Key="SidebarCategoryPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,2,8,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签胶囊 -->
        <DataTemplate x:Key="TagEntryTemplate">
            <Button Style="{StaticResource PillGhostButtonStyle}" Content="{Binding Name}"
                    Tag="{Binding}" Padding="10,4" FontSize="12" Margin="0,0,8,6"
                    Click="Entry_Click" />
        </DataTemplate>

        <!-- 子分类胶囊（无下一级） -->
        <DataTemplate x:Key="CategoryChildTemplate">
            <RadioButton Style="{StaticResource SidebarCategoryPillStyle}"
                         GroupName="CategoryNav" Content="{Binding Name}" Tag="{Binding}"
                         FontSize="12" Margin="0,2,8,2" Padding="10,4"
                         Click="Entry_Click" />
        </DataTemplate>

        <!-- 分类条目：父分类胶囊 + 缩进的子分类 -->
        <DataTemplate x:Key="CategoryEntryTemplate">
            <StackPanel Margin="0,0,8,6">
                <RadioButton Style="{StaticResource SidebarCategoryPillStyle}"
                             GroupName="CategoryNav" Content="{Binding Name}" Tag="{Binding}"
                             IsChecked="{Binding IsDefault}"
                             Click="Entry_Click" />
                <ItemsControl ItemsSource="{Binding Children}"
                              ItemTemplate="{StaticResource CategoryChildTemplate}"
                              Margin="16,2,0,0" />
            </StackPanel>
        </DataTemplate>

        <views:ThemeEntryTemplateSelector x:Key="EntryTemplateSelector"
                                          CategoryTemplate="{StaticResource CategoryEntryTemplate}"
                                          TagTemplate="{StaticResource TagEntryTemplate}" />

        <!-- 分区模板：标题 + 条目流 -->
        <DataTemplate x:Key="SectionTemplate">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Entries}"
                              ItemTemplateSelector="{StaticResource EntryTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="258" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：主题分区（对应网站 /theme/ 页左侧标签区） -->
        <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="主题分区" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="点击分类或标签浏览" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SidebarPanel" ItemTemplate="{StaticResource SectionTemplate}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右侧主区 -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 头部：主题发现标题 + 排行链接 -->
            <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="主题发现" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="排行" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PillGhostButtonStyle}" Content="總排行"
                                Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                Click="RankAll_Click" />
                        <Button Style="{StaticResource PillGhostButtonStyle}" Content="日排行"
                                Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                Click="RankToday_Click" />
                        <Button Style="{StaticResource PillGhostButtonStyle}" Content="周排行"
                                Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                Click="RankWeek_Click" />
                        <Button Style="{StaticResource PillGhostButtonStyle}" Content="月排行"
                                Padding="10,4" FontSize="12"
                                Click="RankMonth_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 搜索栏 -->
            <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,10,0">
                        <TextBox x:Name="KeywordBox" Style="{StaticResource ModernTextBoxStyle}"
                                 MinWidth="120" Padding="34,7,30,7"
                                 KeyDown="KeywordBox_KeyDown"
                                 GotFocus="KeywordBox_GotFocus" LostFocus="KeywordBox_LostFocus"
                                 TextChanged="KeywordBox_TextChanged"
                                 VerticalContentAlignment="Center"
                                 ToolTip="输入标签或关键词，与当前分类组合搜索" />
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <TextBlock x:Name="KeywordPlaceholder" Text="输入标签或关键词，与当前分类组合搜索" FontSize="12.5"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   IsHitTestVisible="False" Margin="34,0,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <Button x:Name="ClearKeywordButton" Style="{StaticResource IconButtonStyle}"
                                ToolTip="清除" Click="ClearKeywordButton_Click"
                                HorizontalAlignment="Right" Margin="0,0,4,0"
                                VerticalAlignment="Center" Padding="6" FontSize="12">
                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <ComboBox x:Name="SortBox" Grid.Column="1" Style="{StaticResource SortPillComboBoxStyle}" Width="132"
                              SelectionChanged="SortBox_SelectionChanged">
                        <ComboBoxItem Content="最新发布" Tag="Latest" />
                        <ComboBoxItem Content="最多观看" Tag="View" />
                        <ComboBoxItem Content="图片最多" Tag="Picture" />
                        <ComboBoxItem Content="最多点赞" Tag="Like" />
                    </ComboBox>
                    <ComboBox x:Name="PeriodBox" Grid.Column="2" Style="{StaticResource SortPillComboBoxStyle}" Width="128" Margin="10,0,0,0"
                              SelectionChanged="PeriodBox_SelectionChanged">
                        <ComboBoxItem Content="全部时间" Tag="All" />
                        <ComboBoxItem Content="今天" Tag="Today" />
                        <ComboBoxItem Content="本周" Tag="Week" />
                        <ComboBoxItem Content="本月" Tag="Month" />
                    </ComboBox>
                    <Button Grid.Column="3" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="搜索" Click="SearchButton_Click" />
                    <controls:CardSizeSlider Grid.Column="4" Margin="14,0,0,0"
                                             Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 内容区 -->
            <ContentControl Grid.Row="2" Style="{StaticResource StateHostStyle}" />

            <!-- 分页 -->
            <StackPanel x:Name="PagingPanel" Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="999" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevButton" Style="{StaticResource PaginationButtonStyle}"
                                ToolTip="上一页" Click="PrevButton_Click">
                            <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                        <Border Style="{StaticResource CountBadgeStyle}" Margin="4,0" MinWidth="84">
                            <TextBlock x:Name="PageText" FontSize="12.5"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <Button x:Name="NextButton" Style="{StaticResource PaginationButtonStyle}"
                                ToolTip="下一页" Click="NextButton_Click">
                            <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</controls:CardGridViewBase>



