<UserControl x:Class="JmComic.App.Views.WeeklyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JmComic.App.Controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 计数 + 右侧刷新 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="每周必看" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Border Style="{StaticResource CountBadgeStyle}" Margin="10,0,0,0">
                    <TextBlock x:Name="WeeklyCount" FontSize="11"
                               Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
            </StackPanel>
            <Button Style="{StaticResource GhostButtonStyle}" Content="刷新"
                    HorizontalAlignment="Right"
                    Click="RefreshButton_Click" />
        </Grid>

        <!-- 筛选区：分类下拉 + 类型分段 -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Padding="12"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="CategoryBox" Width="180" MinHeight="36"
                          SelectionChanged="CategoryBox_SelectionChanged" />
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="8"
                        Padding="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel x:Name="TypePanel" Orientation="Horizontal" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="18"
                        Background="{DynamicResource HoverBgBrush}">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="加载中…" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="正在获取每周必看内容，稍候片刻" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Border Width="64" Height="64" CornerRadius="18"
                        Background="{DynamicResource HoverBgBrush}">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="本周暂无必看内容" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="换个分类或类型再试试吧" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,6,0,0" HorizontalAlignment="Center" />
                <Button Style="{StaticResource PillGhostButtonStyle}" Content="重新加载"
                        Margin="0,18,0,0" HorizontalAlignment="Center"
                        Click="RefreshButton_Click" />
            </StackPanel>

            <ScrollViewer x:Name="ResultScroller" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <ItemsControl x:Name="WeeklyItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:AutoColumnsUniformGrid ItemSlotWidth="182" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:AlbumCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>