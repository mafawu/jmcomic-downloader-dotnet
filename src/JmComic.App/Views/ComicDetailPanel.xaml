<UserControl x:Class="JmComic.App.Views.ComicDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="漫画详情" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 详情内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,0,16,16">
            <StackPanel>
                <!-- 封面 -->
                <Border Height="220" CornerRadius="12"
                        Background="{DynamicResource HoverBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Image x:Name="CoverImage" Stretch="Uniform" Margin="8" />
                </Border>

                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="TitleCnText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                <ItemsControl x:Name="TagItems" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ActiveNavBgBrush}"
                                    CornerRadius="5" Padding="7,3" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="AuthorText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="WorksText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ActorsText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="MetaText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="DescLabel" Text="简介" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,14,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="DescText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                <TextBlock x:Name="PathText" FontSize="10.5" FontFamily="Consolas"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>