<UserControl x:Class="JmComic.App.Views.ComicDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="漫画详情" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 详情内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,0,18,18">
            <StackPanel>
                <!-- 封面 -->
                <Border Height="220" CornerRadius="18"
                        Background="{DynamicResource HoverBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Image x:Name="CoverImage" Stretch="Uniform" Margin="8" />
                </Border>

                <DockPanel Margin="0,12,0,0" LastChildFill="True"><Border x:Name="KindBadgeDetail" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" DockPanel.Dock="Right" VerticalAlignment="Center"><TextBlock Text="漫" FontSize="10" Foreground="White" FontWeight="Bold"/></Border><TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" /></DockPanel>
                <TextBlock x:Name="TitleCnText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                <ItemsControl x:Name="TagItems" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ActiveNavBgBrush}"
                                    CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="AuthorText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="WorksText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="ActorsText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="MetaText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="DescLabel" Text="简介" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,14,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="DescText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                <!-- 统计区（仿 Green DetailPanel stats） -->
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock x:Name="StatChapterText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="章节" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="StatViewText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="浏览" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock x:Name="StatLikeText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="收藏" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Grid></Border>
                <TextBlock x:Name="PathText" FontSize="10.5" FontFamily="Consolas"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
