<UserControl x:Class="JmComic.App.Views.ChapterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Margin="16,16,16,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Border Width="72" Height="96" CornerRadius="10" Background="{DynamicResource HoverBgBrush}" />
                    <Image x:Name="CoverImage" Width="72" Height="96" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="返回"
                                    Click="BackButton_Click">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            </Button>
                            <TextBlock x:Name="HeaderTitle" FontSize="17" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       MaxWidth="520" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ReadAllButton" Style="{StaticResource PrimaryButtonStyle}"
                                    Content="在线阅读" Margin="0,0,8,0" IsEnabled="False"
                                    Click="ReadAllButton_Click" />
                        <Button x:Name="FavoriteButton" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="FavoriteButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FavoriteIcon" Text="&#xEB51;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                <TextBlock x:Name="FavoriteText" Text="收藏" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="HeaderMeta" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeaderDesc" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 章节区（框选） -->
        <Grid Grid.Row="1" Margin="16,12,16,0" x:Name="ChaptersLayer"
              PreviewMouseLeftButtonDown="ChaptersLayer_PreviewMouseLeftButtonDown"
              PreviewMouseMove="ChaptersLayer_PreviewMouseMove"
              PreviewMouseLeftButtonUp="ChaptersLayer_PreviewMouseLeftButtonUp">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="下载选中章节" Click="ContextDownloadSelected_Click" />
                    <MenuItem Header="全选" Click="SelectAllButton_Click" />
                    <MenuItem Header="清除选择" Click="ClearButton_Click" />
                    <Separator />
                    <MenuItem Header="下载全部章节" Click="DownloadAllButton_Click" />
                </ContextMenu>
            </Grid.ContextMenu>

            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ChapterItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Width="158" Height="52" Margin="0,0,10,10"
                                    CornerRadius="10"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ChapterCard_MouseLeftButtonDown">
                                <Grid>
                                    <Rectangle x:Name="SelectedAccent" Width="3" RadiusX="1.5" RadiusY="1.5"
                                               Fill="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Left" Margin="0,8" Visibility="Collapsed" />
                                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                    MaxWidth="72"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Style="{StaticResource StatusBadgeStyle}"
                                                    Background="{DynamicResource SuccessBrush}"
                                                    Padding="7,2" x:Name="DownloadedBadge"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="已下载" FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                            <Border Style="{StaticResource StatusBadgeStyle}"
                                                    Background="{DynamicResource PrimaryLightBrush}"
                                                    Padding="7,2" Margin="6,0,0,0"
                                                    x:Name="DownloadingBadge"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="下载中" FontSize="10"
                                                           Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButtonStyle}" Width="26" Height="34"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,4,0" ToolTip="在线阅读本章"
                                            Command="{Binding ReadCommand}">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                    </Button>
                                    <Border x:Name="SelectedCheck" Width="18" Height="18" CornerRadius="9"
                                            Background="{DynamicResource PrimaryBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,6,0" Visibility="Collapsed">
                                        <Path Data="M 0 4 L 4 8 L 9 0" Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                    <Setter TargetName="DownloadedBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                    <Setter TargetName="DownloadingBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Card" Property="Background"
                                            Value="{DynamicResource PrimarySubtleBrush}" />
                                    <Setter TargetName="Card" Property="BorderBrush"
                                            Value="{DynamicResource PrimaryBrush}" />
                                    <Setter TargetName="SelectedAccent" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                           Fill="{DynamicResource SelectionBgBrush}"
                           Stroke="{DynamicResource PrimaryBrush}"
                           StrokeThickness="1.2" RadiusX="4" RadiusY="4" />
            </Canvas>

            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource AppBackgroundBrush}">
                <TextBlock Text="加载中…" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,12" />
            </StackPanel>
        </Grid>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Margin="16,0,16,16" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectedText" Text="未选择章节" FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="全选"
                            Margin="14,0,0,0" Click="SelectAllButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="清除"
                            Margin="8,0,0,0" Click="ClearButton_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="DownloadSelectedButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="下载选中" Click="DownloadSelectedButton_Click" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="下载全部"
                            Margin="8,0,0,0" Click="DownloadAllButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
