<UserControl x:Class="JmComic.App.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JmComic.App.Controls"
             Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="本地视频" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Style="{StaticResource CountBadgeStyle}" Margin="10,0,0,0">
                    <TextBlock x:Name="VideoCountText" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="SortBox" Style="{StaticResource SortPillComboBoxStyle}" Width="140"
                          VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                    <ComboBoxItem Content="最近添加" Tag="AddedDesc" />
                    <ComboBoxItem Content="最早添加" Tag="AddedAsc" />
                    <ComboBoxItem Content="名称 A → Z" Tag="NameAsc" />
                    <ComboBoxItem Content="名称 Z → A" Tag="NameDesc" />
                    <ComboBoxItem Content="评分最高" Tag="RatingDesc" />
                    <ComboBoxItem Content="大小 ↓" Tag="SizeDesc" />
                </ComboBox>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="添加文件夹"
                        Margin="12,0,0,0" Padding="14,6" Click="AddFolder_Click" />
            </StackPanel>
        </Grid>

        <!-- 内容区 -->
        <Grid Grid.Row="1">
            <!-- 空状态 -->
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="72" Height="72" CornerRadius="24" Background="{DynamicResource HoverBgBrush}">
                    <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="还没有添加视频文件夹" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="点击「添加文件夹」将本地视频目录加入库中" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                <Button Content="添加第一个文件夹" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,18,0,0" Click="AddFolder_Click" />
            </StackPanel>

            <!-- 卡片网格 -->
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <WrapPanel x:Name="CardsPanel" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>