<controls:CardGridViewBase x:Class="JmComic.App.Views.CategoryBrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JmComic.App.Controls">
    <UserControl.Resources>
        <!-- 加载态 -->
        <DataTemplate x:Key="LoadingStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="加载分类中…" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- 空态 -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="24"
                        Background="{DynamicResource HoverBgBrush}">
                    <Path Data="{StaticResource IconDocument}" Stroke="{DynamicResource TextDisabledBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="该分类暂时没有漫画" FontSize="15" FontWeight="SemiBold"
                           Margin="0,16,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 结果态：卡片网格（虚拟化：只实例化可视行） -->
        <DataTemplate x:Key="ResultStateTemplate">
            <controls:VirtualizedCardGrid ItemsSource="{Binding Results, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SlotWidth="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CardWidth="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <controls:VirtualizedCardGrid.ItemTemplate>
                    <DataTemplate>
                        <controls:AlbumCard Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=controls:VirtualizedCardGrid}}" />
                    </DataTemplate>
                </controls:VirtualizedCardGrid.ItemTemplate>
            </controls:VirtualizedCardGrid>
        </DataTemplate>

        <Style x:Key="StateHostStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource LoadingStateTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Empty">
                    <Setter Property="ContentTemplate" Value="{StaticResource EmptyStateTemplate}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentState, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="Result">
                    <Setter Property="ContentTemplate" Value="{StaticResource ResultStateTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 分类胶囊 -->
        <Style x:Key="CategoryPillStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,2,8,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySubtleBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：分类列表 -->
        <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Padding="16" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="CategoryTitle" Text="分类" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CategoryList" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右侧：页头 + 漫画网格 + 分页 -->
        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页头：标题 + 分格 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCategory}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="分类浏览" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <controls:CardSizeSlider CellScale="{Binding CellScale, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ContentControl Grid.Row="1" Style="{StaticResource StateHostStyle}" />

            <StackPanel x:Name="PagingPanel" Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,14,0,0">
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="999" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevButton" Style="{StaticResource PaginationButtonStyle}"
                                ToolTip="上一页" Click="PrevButton_Click">
                            <Path Data="{StaticResource IconChevronLeft}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                        <Border Style="{StaticResource CountBadgeStyle}" Margin="4,0" MinWidth="84">
                            <TextBlock x:Name="PageText" FontSize="12.5"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Border>
                        <Button x:Name="NextButton" Style="{StaticResource PaginationButtonStyle}"
                                ToolTip="下一页" Click="NextButton_Click">
                            <Path Data="{StaticResource IconChevronRight}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</controls:CardGridViewBase>
