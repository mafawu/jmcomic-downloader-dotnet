<UserControl x:Class="JmComic.App.Views.LocalComicDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="本地详情" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource GhostButtonStyle}" Content="返回列表"
                    HorizontalAlignment="Right" Padding="10,4"
                    Click="BackButton_Click" />
        </Grid>

        <!-- 详情内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="18,0,18,18">
            <StackPanel>
                <!-- 封面 -->
                <Border Height="220" CornerRadius="18"
                        Background="{DynamicResource HoverBgBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Image x:Name="CoverImage" Stretch="Uniform" Margin="8" />
                </Border>

                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="TitleCnText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

                <TextBlock x:Name="MetaText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" />

                <!-- 更新检查 -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,0" />
                <TextBlock Text="更新检查" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,14,0,0" />
                <TextBlock x:Name="UpdateStatusText" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="点击「检查更新」查看是否有新章节" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CheckUpdateButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="检查更新" Padding="14,6"
                            Click="CheckUpdateButton_Click" />
                    <Button x:Name="DownloadUpdateButton" Style="{StaticResource GhostButtonStyle}"
                            Content="更新下载" Margin="8,0,0,0" Padding="14,6"
                            IsEnabled="False"
                            ToolTip="将新增章节加入下载队列"
                            Click="DownloadUpdateButton_Click" />
                </StackPanel>

                <!-- 统计区（仿 Green DetailPanel） -->
                <Border Background="{DynamicResource HoverBgBrush}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center"><TextBlock x:Name="StatChapterText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="章节" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock x:Name="StatImageText" Text="--" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="图片" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="阅读" Padding="14,6" x:Name="ReadButton"/>
                    <Button Style="{StaticResource GhostButtonStyle}" Content="打开目录" Margin="8,0,0,0" Padding="14,6" x:Name="OpenFolderButton"/>
                </StackPanel>
                <TextBlock x:Name="PathText" FontSize="10.5" FontFamily="Consolas"
                           Foreground="{DynamicResource TextDisabledBrush}"
                           TextWrapping="Wrap" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

