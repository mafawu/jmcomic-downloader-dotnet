<UserControl x:Class="JmComic.App.Views.DownloadPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="下载队列" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Speed}" FontSize="12" FontFamily="Consolas"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- 全局进度 -->
        <Border Grid.Row="1" Margin="12,0,12,10" Padding="12,10" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                    <Setter Property="Margin" Value="12,0,12,10" />
                    <Setter Property="Padding" Value="12,10" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllDone}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}"
                               FontSize="22" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{DynamicResource PrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressSummary}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllDone}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Height="6" Margin="0,8,0,0"
                                 Value="{Binding OverallProgress, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource ModernProgressBarStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllDone}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 任务列表 -->
        <Grid Grid.Row="2">
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{DynamicResource PrimarySubtleBrush}">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="暂无下载任务" FontSize="13" FontWeight="SemiBold"
                           Margin="0,14,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="在章节页选择章节即可下载" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                <ItemsControl x:Name="TaskItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8"
                                    Padding="12,10" CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="220" VerticalAlignment="Center" />
                                        <Border x:Name="StatusBadge"
                                                Style="{StaticResource StatusBadgeStyle}"
                                                HorizontalAlignment="Right" Margin="8,0,0,0">
                                            <TextBlock x:Name="BadgeText" Text="{Binding StatusText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <ProgressBar x:Name="ItemProgress" Height="4" Margin="0,8,0,0"
                                                 Visibility="Collapsed"
                                                 Value="{Binding Progress, Mode=OneWay}" />
                                    <TextBlock Text="{Binding ProgressText}"
                                               FontSize="10.5" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextDisabledBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                    <Setter TargetName="StatusBadge" Property="Background"
                                            Value="{DynamicResource PrimaryLightBrush}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                                    <Setter TargetName="ItemProgress" Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter TargetName="StatusBadge" Property="Background"
                                            Value="{DynamicResource SuccessBrush}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="StatusBadge" Property="Background"
                                            Value="{DynamicResource DangerBrush}" />
                                    <Setter TargetName="BadgeText" Property="Foreground" Value="White" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>