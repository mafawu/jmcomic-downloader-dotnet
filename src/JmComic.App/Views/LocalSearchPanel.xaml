<UserControl x:Class="JmComic.App.Views.LocalSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <UserControl.Resources>
        <!-- 标签筛选 ToggleButton 样式 -->
        <Style x:Key="LocalTagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource HoverBgBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveNavBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="本地搜索" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 关键字输入框 -->
        <Border Grid.Row="1" Margin="12,0,12,10" CornerRadius="8"
                Background="{DynamicResource HoverBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <TextBox x:Name="KeywordBox" BorderThickness="0" Background="Transparent"
                         Padding="12,8" FontSize="12.5"
                         TextChanged="KeywordBox_TextChanged" />
                <TextBlock x:Name="PlaceholderText" Text="搜索漫画名 / 作者 / 标签"
                           FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="13,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <Button x:Name="ClearButton" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0" ToolTip="清除筛选" Click="ClearButton_Click"
                        Visibility="Collapsed">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- 标签列表 -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="12,0,12,12">
                <ItemsControl x:Name="TagItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>