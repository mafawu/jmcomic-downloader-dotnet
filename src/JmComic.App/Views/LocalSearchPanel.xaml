<UserControl x:Class="JmComic.App.Views.LocalSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource SurfaceBrush}">
    <UserControl.Resources>
        <!-- 筛选：排除态（仿 Green FilterSidebar ∅） -->
        <Style x:Key="LocalTagToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource HoverBgBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveNavBgBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="excluded">
                                <Setter TargetName="Bd" Property="Background" Value="#1AE5484D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33E5484D" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="18,16,18,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock Text="本地搜索" FontSize="15" FontWeight="Bold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 关键字输入框 -->
        <Border Grid.Row="1" Margin="14,0,14,12" CornerRadius="10"
                Background="{DynamicResource HoverBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <TextBox x:Name="KeywordBox" BorderThickness="0" Background="Transparent"
                         Padding="12,9" FontSize="12.5"
                         TextChanged="KeywordBox_TextChanged"
                         GotFocus="KeywordBox_GotFocus" LostFocus="KeywordBox_LostFocus" />
                <TextBlock x:Name="PlaceholderText" Text="搜索漫画名 / 作者 / 标签"
                           FontSize="12" Foreground="{DynamicResource TextDisabledBrush}"
                           Margin="13,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <Button x:Name="ClearButton" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,4,0" ToolTip="清除筛选" Click="ClearButton_Click"
                        Visibility="Collapsed">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="11" Height="11" />
                </Button>
            </Grid>
        </Border>

        <!-- 筛选区：标签 + 作者（仿 Green FilterSidebar） -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,0,14,14">
            <StackPanel>
                <!-- 标签筛选 -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="标签筛选" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TagCountText" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ClearTagFilterButton" Style="{StaticResource GhostButtonStyle}" Content="清除" FontSize="10.5" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearTagFilter_Click" />
                </Grid>
                <TextBlock x:Name="TagEmptyText" Text="暂无标签" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,2,0,8" Visibility="Collapsed" />
                <ItemsControl x:Name="TagItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,10" />
                <!-- 作者筛选 -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="作者筛选" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AuthorCountText" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="ClearAuthorFilterButton" Style="{StaticResource GhostButtonStyle}" Content="清除" FontSize="10.5" Padding="6,2"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClearAuthorFilter_Click" />
                </Grid>
                <TextBlock x:Name="AuthorEmptyText" Text="暂无作者" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,2,0,8" Visibility="Collapsed" />
                <ItemsControl x:Name="AuthorItems">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="左键包含 · 右键排除" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,12,0,0" HorizontalAlignment="Center" Opacity="0.7" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>


