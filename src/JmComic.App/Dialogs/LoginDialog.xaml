<Window x:Class="JmComic.App.Dialogs.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="28,24"
            Margin="14"
            Effect="{StaticResource CardShadowEffect}">
        <StackPanel>
            <Grid>
                <TextBlock Text="登录禁漫账号" FontSize="17" FontWeight="Bold" />
                <Button Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                </Button>
            </Grid>
            <TextBlock Text="登录后可同步收藏夹，账号密码仅保存在本地配置"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="账号" FontSize="12" Margin="0,18,0,6" />
            <TextBox x:Name="UsernameBox" Style="{StaticResource ModernTextBoxStyle}"
                     VerticalContentAlignment="Center" />
            <TextBlock Text="密码" FontSize="12" Margin="0,14,0,6" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBoxStyle}"
                         KeyDown="PasswordBox_KeyDown" />

            <Border x:Name="ErrorCapsule" Background="{DynamicResource DangerBrush}"
                    CornerRadius="999" Padding="14,6" Margin="0,12,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="White"
                           TextWrapping="Wrap" HorizontalAlignment="Center" />
            </Border>

            <CheckBox x:Name="RememberBox" Content="记住账号"
                      Style="{StaticResource ModernCheckBoxStyle}"
                      ToolTip="记住账号功能将在后续版本接入配置保存"
                      Margin="0,14,0,0" />

            <Button x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" Margin="0,14,0,0"
                    Click="LoginButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path x:Name="BusyIcon" Data="{StaticResource IconLoading}"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" Width="14" Height="14"
                          Visibility="Collapsed" VerticalAlignment="Center">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="BusySpin" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="BusySpin"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock x:Name="BusyText" Text="登录中…" FontSize="13"
                               Margin="8,0,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="NormalText" Text="登录" FontSize="13" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</Window>