<Window x:Class="JmComic.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="22"
            Padding="26,22"
            Margin="14"
            Effect="{StaticResource CardShadowEffect}">
        <StackPanel>
            <Grid>
                <TextBlock Text="设置" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" />
                </Button>
            </Grid>

            <TextBlock Text="下载设置" FontSize="13" FontWeight="Bold" Margin="0,16,0,0" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="下载目录" Grid.Row="0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DownloadDirBox" Padding="8,6" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="浏览…"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            Click="BrowseDownloadDir_Click" />
                </Grid>

                <TextBlock Text="图片格式" Grid.Row="1" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="FormatBox" Grid.Row="1" Grid.Column="1" Width="160"
                          HorizontalAlignment="Left" Margin="0,0,0,10" VerticalAlignment="Center">
                    <ComboBoxItem Content="JPEG" Tag="Jpeg" />
                    <ComboBoxItem Content="PNG" Tag="Png" />
                    <ComboBoxItem Content="WEBP" Tag="Webp" />
                </ComboBox>

                <TextBlock Text="接口域名" Grid.Row="2" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="ApiDomainsBox" Grid.Row="2" Grid.Column="1"
                         Margin="0,0,0,4" Padding="8,6" Height="64"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" />

                <TextBlock Text="多个域名用逗号分隔，请求失败自动切换；留空使用默认列表" Grid.Row="3" Grid.Column="1"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>

            <TextBlock Text="标题翻译（中文名）" FontSize="13" FontWeight="Bold" Margin="0,14,0,0" />
            <CheckBox x:Name="TranslateEnabledBox"
                      Content="启用翻译（扫描时自动为缺失中文名的漫画翻译标题）"
                      Margin="0,10,0,0" FontSize="12.5" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="接口地址" Grid.Row="0" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="TranslateBaseUrlBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,0,0,10" Padding="8,6" VerticalAlignment="Center" />

                <TextBlock Text="API Key" Grid.Row="1" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="TranslateApiKeyBox" Grid.Row="1" Grid.Column="1"
                         Margin="0,0,0,10" Padding="8,6" VerticalAlignment="Center" />

                <TextBlock Text="模型" Grid.Row="2" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox x:Name="TranslateModelBox" Grid.Row="2" Grid.Column="1"
                         Padding="8,6" VerticalAlignment="Center" />
            </Grid>

            <TextBlock x:Name="ErrorText" FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       Margin="0,10,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButtonStyle}" Content="取消"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存"
                        Margin="10,0,0,0" Click="SaveButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>