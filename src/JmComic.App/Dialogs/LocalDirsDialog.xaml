<Window x:Class="JmComic.App.Dialogs.LocalDirsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理本地路径" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="26,22"
            Margin="12">
        <StackPanel>
            <Grid>
                <TextBlock Text="管理本地路径" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" />
                </Button>
            </Grid>
            <TextBlock Text="本地模式将从这些目录中扫描已下载的漫画（每个一级子目录视为一部漫画，.下载中- 开头的临时目录会被跳过）"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,6,0,0" TextWrapping="Wrap" />

            <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Margin="0,16,0,0">
                <ListBox x:Name="DirList" Height="228" BorderThickness="0"
                         Background="Transparent" Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Path}" FontSize="12.5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" ToolTip="移除该路径"
                                        Click="RemoveDir_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource GhostButtonStyle}" Content="添加路径…"
                        Click="AddDir_Click" />
                <TextBlock x:Name="ErrorText" FontSize="12"
                           Foreground="{DynamicResource DangerBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource GhostButtonStyle}" Content="取消"
                        Click="CancelButton_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="确定"
                        Margin="10,0,0,0" Click="OkButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
