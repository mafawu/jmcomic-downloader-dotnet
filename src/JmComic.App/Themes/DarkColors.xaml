<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         深色主题 · 暗夜霓虹（Midnight × Neon）
         深蓝黑背景 + 玫红紫罗兰霓虹，沉浸式、高对比、有冲击力
         ================================================================ -->

    <!-- 背景 / 表面 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0E1A" />
    <SolidColorBrush x:Key="AppBackgroundTopBrush" Color="#12142A" />
    <SolidColorBrush x:Key="AppBackgroundBottomBrush" Color="#0A0B15" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A2E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#262A44" />
    <SolidColorBrush x:Key="DividerBrush" Color="#21243C" />
    <SolidColorBrush x:Key="DividerStrongBrush" Color="#2E3352" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1EDF9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A49CB8" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#5E5670" />

    <!-- 主色：霓虹玫红（暗底提亮） -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3D8D" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF5FA0" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#E02074" />
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FF6FB0" />
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="#3A1B35" />
    <!-- 主按钮渐变（玫红 → 霓虹紫） -->
    <SolidColorBrush x:Key="PrimaryGradientStartBrush" Color="#FF3D8D" />
    <SolidColorBrush x:Key="PrimaryGradientEndBrush" Color="#A855F7" />

    <!-- 状态色（霓虹化） -->
    <SolidColorBrush x:Key="DangerBrush" Color="#F2555A" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3ECF8E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F2B356" />

    <!-- 输入框 -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#343852" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#FF3D8D" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="#59FF3D8D" />

    <!-- 交互层 -->
    <SolidColorBrush x:Key="HoverBgBrush" Color="#1AF1EDF9" />
    <SolidColorBrush x:Key="ActiveNavBgBrush" Color="#33FF3D8D" />
    <SolidColorBrush x:Key="SelectionBgBrush" Color="#40FF3D8D" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#55A49CB8" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#77A49CB8" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#8C000000" />
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#14F1EDF9" />

    <!-- 卡片 hover：上浮 + 霓虹光晕 -->
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1C1F38" />
    <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#FF5FA0" />
    <SolidColorBrush x:Key="CardShadowBrush" Color="#59000000" />

    <SolidColorBrush x:Key="CardHoverShadowBrush" Color="#33FF3D8D" />
    <SolidColorBrush x:Key="SkeletonBrush" Color="#21243C" />
    <SolidColorBrush x:Key="SnackbarBgBrush" Color="#F0171A2E" />
    <SolidColorBrush x:Key="TextLinkBrush" Color="#FF5FA0" />

    <!-- 阴影 / 光晕（Color 资源，供 DropShadowEffect 使用） -->
    <Color x:Key="CardShadowColor">#59000000</Color>
    <Color x:Key="PrimaryGlowColor">#73FF3D8D</Color>

    <!-- 渐变用 Color 资源（GradientStop.Color 需要 Color 类型，不能用上面的 SolidColorBrush） -->
    <Color x:Key="PrimaryGradientStartColor">#FF3D8D</Color>
    <Color x:Key="PrimaryGradientEndColor">#A855F7</Color>
    <Color x:Key="PrimaryHoverColor">#FF5FA0</Color>
    <Color x:Key="PrimaryPressedColor">#E02074</Color>
    <Color x:Key="AppBackgroundTopColor">#12142A</Color>
    <Color x:Key="AppBackgroundBottomColor">#0A0B15</Color>

    <!-- 窗口外框：淡雅浅色渐变（低饱和，暗底下带一点紫灰） -->
    <LinearGradientBrush x:Key="WindowBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A3C55" Offset="0" />
        <GradientStop Color="#33344E" Offset="0.5" />
        <GradientStop Color="#463E58" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
