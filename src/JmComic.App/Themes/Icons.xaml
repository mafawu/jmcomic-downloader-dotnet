<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         矢量图标集 · 线性风格（24×24 viewbox，Stroke 渲染，圆角端点）
         用法：<Path Data="{StaticResource IconXxx}" Stroke="..." StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stretch="Uniform" Width="16" Height="16" />
         ================================================================ -->

    <!-- 搜索（放大镜） -->
    <Geometry x:Key="IconSearch">M 10.5 3.5 a 7 7 0 1 0 0 14 a 7 7 0 1 0 0 -14 M 15.5 15.5 L 20.5 20.5</Geometry>

    <!-- 收藏（星形） -->
    <Geometry x:Key="IconFavoriteStar">M 12 3 L 14.8 9.2 L 21.5 9.9 L 16.6 14.6 L 18 21.2 L 12 17.8 L 6 21.2 L 7.4 14.6 L 2.5 9.9 L 9.2 9.2 Z</Geometry>

    <!-- 本地（书架） -->
    <Geometry x:Key="IconLibrary">M 5.5 3.5 L 5.5 20.5 M 12 3.5 L 12 20.5 M 18.5 3.5 L 18.5 20.5 M 3 20.5 L 21 20.5</Geometry>

    <!-- 下载队列（下载箭头） -->
    <Geometry x:Key="IconDownload">M 12 3.5 L 12 14.5 M 7.5 10 L 12 14.5 L 16.5 10 M 4.5 19.5 L 19.5 19.5</Geometry>

    <!-- 太阳（浅色图标） -->
    <Geometry x:Key="IconSun">M 12 4 a 8 8 0 1 0 0 16 a 8 8 0 1 0 0 -16 M 12 1.5 L 12 4 M 12 20 L 12 22.5 M 1.5 12 L 4 12 M 20 12 L 22.5 12 M 4.4 4.4 L 6.2 6.2 M 17.8 17.8 L 19.6 19.6 M 4.4 19.6 L 6.2 17.8 M 17.8 6.2 L 19.6 4.4</Geometry>

    <!-- 月亮（深色图标） -->
    <Geometry x:Key="IconMoon">M 20.2 14.5 A 8 8 0 1 1 9.5 3.8 A 7 7 0 0 0 20.2 14.5</Geometry>

    <!-- 打开目录（文件夹） -->
    <Geometry x:Key="IconFolderOpen">M 3 7 L 10 7 L 12 9 L 21 9 L 21 19 L 3 19 Z M 3 7 L 3 5.5 L 10 5.5 L 12 7.5 L 21 7.5</Geometry>

    <!-- 返回（左箭头） -->
    <Geometry x:Key="IconBack">M 15 5 L 8 12 L 15 19</Geometry>

    <!-- 刷新（循环箭头） -->
    <Geometry x:Key="IconRefresh">M 12 4.5 A 7.5 7.5 0 0 1 19.5 12 M 20.5 3.5 L 20.5 8.5 L 15.5 8.5</Geometry>

    <!-- 关闭 / 清除（叉） -->
    <Geometry x:Key="IconClose">M 6 6 L 18 18 M 18 6 L 6 18</Geometry>

    <!-- 勾 -->
    <Geometry x:Key="IconCheck">M 5 12.5 L 10 17.5 L 19 6.5</Geometry>

    <!-- 信息 -->
    <Geometry x:Key="IconInfo">M 12 3.5 a 8.5 8.5 0 1 0 0 17 a 8.5 8.5 0 1 0 0 -17 M 12 11 L 12 16.5 M 12 7.5 L 12 8.2</Geometry>

    <!-- 退出登录（门 + 箭头） -->
    <Geometry x:Key="IconSignOut">M 10 4 L 4 4 L 4 20 L 10 20 M 14 8 L 19 12 L 14 16 M 19 12 L 7.5 12</Geometry>

    <!-- 上一页 -->
    <Geometry x:Key="IconChevronLeft">M 14 6 L 8 12 L 14 18</Geometry>

    <!-- 下一页 -->
    <Geometry x:Key="IconChevronRight">M 10 6 L 16 12 L 10 18</Geometry>

    <!-- 设置（齿轮） -->
    <Geometry x:Key="IconSetting">M 12 3 L 12 5.5 M 12 18.5 L 12 21 M 3 12 L 5.5 12 M 18.5 12 L 21 12 M 5.6 5.6 L 7.4 7.4 M 16.6 16.6 L 18.4 18.4 M 5.6 18.4 L 7.4 16.6 M 16.6 7.4 L 18.4 5.6 M 12 8.5 a 3.5 3.5 0 1 0 0 7 a 3.5 3.5 0 1 0 0 -7</Geometry>

    <!-- 心（收藏） -->
    <Geometry x:Key="IconHeart">M 12 19.5 C 6.5 15 3.5 11.5 3.5 8.5 C 3.5 6 5.5 4 8 4 C 9.5 4 11 4.8 12 6.2 C 13 4.8 14.5 4 16 4 C 18.5 4 20.5 6 20.5 8.5 C 20.5 11.5 17.5 15 12 19.5 Z</Geometry>

    <!-- 最小化 -->
    <Geometry x:Key="IconMinimize">M 5 12 L 19 12</Geometry>

    <!-- 最大化 -->
    <Geometry x:Key="IconMaximize">M 7 7 L 17 7 L 17 17 L 7 17 Z</Geometry>

    <!-- 还原 -->
    <Geometry x:Key="IconRestore">M 5.5 5.5 L 13.5 5.5 L 13.5 13.5 L 5.5 13.5 Z M 8 8 L 16 8 L 16 16 L 8 16 Z</Geometry>

    <!-- 关闭窗口（叉） -->
    <Geometry x:Key="IconCloseWindow">M 6.5 6.5 L 17.5 17.5 M 17.5 6.5 L 6.5 17.5</Geometry>

    <!-- 排行（柱状图 + 基线） -->
    <Geometry x:Key="IconRank">M 4 20 L 4 13 M 10 20 L 10 7 M 16 20 L 16 10 M 3 20 L 21 20</Geometry>

    <!-- 分类（2×2 网格） -->
    <Geometry x:Key="IconCategory">M 4 4 L 10.5 4 L 10.5 10.5 L 4 10.5 Z M 13.5 4 L 20 4 L 20 10.5 L 13.5 10.5 Z M 4 13.5 L 10.5 13.5 L 10.5 20 L 4 20 Z M 13.5 13.5 L 20 13.5 L 20 20 L 13.5 20 Z</Geometry>

    <!-- 每周必看（日历 + 对勾） -->
    <Geometry x:Key="IconWeekly">M 4 6.5 L 20 6.5 L 20 20 L 4 20 Z M 4 10.5 L 20 10.5 M 8 3.5 L 8 8.5 M 16 3.5 L 16 8.5 M 9.5 15 L 11.5 17 L 15 13</Geometry>

    <!-- 阅读（播放三角） -->
    <Geometry x:Key="IconPlay">M 8 5 L 19 12 L 8 19 Z</Geometry>

    <!-- 空状态（文档） -->
    <Geometry x:Key="IconDocument">M 6 3.5 L 12 3.5 L 18 9.5 L 18 20.5 L 6 20.5 Z M 12 3.5 L 12 9.5 L 18 9.5</Geometry>

    <!-- 加载（3/4 弧） -->
    <Geometry x:Key="IconLoading">M 12 4 A 8 8 0 1 1 4.5 8.5</Geometry>

    <!-- 侧栏开关 -->
    <Geometry x:Key="IconPanelToggle">M 4.5 4.5 L 19.5 4.5 L 19.5 19.5 L 4.5 19.5 Z M 13 4.5 L 13 19.5</Geometry>

</ResourceDictionary>
