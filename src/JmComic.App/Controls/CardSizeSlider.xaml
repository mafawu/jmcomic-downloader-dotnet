<UserControl x:Class="JmComic.App.Controls.CardSizeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="分格" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
        <Slider x:Name="ScaleSlider" Width="90" Minimum="0.8" Maximum="1.4"
                Value="1.0" Margin="8,0,0,0" VerticalAlignment="Center"
                ValueChanged="ScaleSlider_ValueChanged" />
        <TextBlock x:Name="ScaleText" Text="100%" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="8,0,0,0" VerticalAlignment="Center"
                   MinWidth="34" TextAlignment="Right" />
    </StackPanel>
</UserControl>
