<UserControl x:Class="JmComic.App.Controls.CardSizeSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ColumnsSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="TrackBg" Height="4" CornerRadius="2"
                                    Background="{DynamicResource DividerBrush}"
                                    VerticalAlignment="Center" Margin="7,0,7,0"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Style>
                                            <Style TargetType="RepeatButton">
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="4" CornerRadius="2" Margin="7,0,0,0"
                                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="{DynamicResource PrimaryGradientStartColor}" Offset="0"/>
                                                                        <GradientStop Color="{DynamicResource PrimaryGradientEndColor}" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RepeatButton.Style>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="Outer" Width="14" Height="14"
                                                             Fill="{DynamicResource SurfaceBrush}"
                                                             Stroke="{DynamicResource CardBorderBrush}" StrokeThickness="1.2">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                                              Opacity="0.22" Color="{DynamicResource CardShadowColor}"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse x:Name="Dot" Width="7" Height="7"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="{DynamicResource PrimaryGradientStartColor}" Offset="0"/>
                                                                <GradientStop Color="{DynamicResource PrimaryGradientEndColor}" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="Outer" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.38" Color="{DynamicResource PrimaryGlowColor}"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Outer" Property="Width" Value="13"/>
                                                        <Setter TargetName="Outer" Property="Height" Value="13"/>
                                                        <Setter TargetName="Dot" Property="Width" Value="6"/>
                                                        <Setter TargetName="Dot" Property="Height" Value="6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBg" Property="Background" Value="{DynamicResource DividerStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder" CornerRadius="10" Height="32" Padding="11,0,8,0"
            SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="92"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" IsHitTestVisible="False">
                <UniformGrid Rows="2" Columns="2">
                    <Border Width="5" Height="5" CornerRadius="1.2" Background="{DynamicResource TextSecondaryBrush}" Margin="0,0,1.5,1.5"/>
                    <Border Width="5" Height="5" CornerRadius="1.2" Background="{DynamicResource TextSecondaryBrush}" Margin="1.5,0,0,1.5"/>
                    <Border Width="5" Height="5" CornerRadius="1.2" Background="{DynamicResource TextSecondaryBrush}" Margin="0,1.5,1.5,0"/>
                    <Border Width="5" Height="5" CornerRadius="1.2" Background="{DynamicResource TextSecondaryBrush}" Margin="1.5,1.5,0,0"/>
                </UniformGrid>
            </Grid>

            <TextBlock Grid.Column="1" Text="分格" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="7,0,0,0"/>

            <Border Grid.Column="2" Width="1" Height="14" Background="{DynamicResource DividerBrush}"
                    Margin="10,0" VerticalAlignment="Center" Opacity="0.9"/>

            <Slider Grid.Column="3" x:Name="ScaleSlider" Minimum="3" Maximum="8" Value="5"
                    IsSnapToTickEnabled="True" TickFrequency="1"
                    Style="{StaticResource ColumnsSliderStyle}"
                    VerticalAlignment="Center"
                    ToolTip="拖动调整每行显示个数"
                    ValueChanged="ScaleSlider_ValueChanged"/>

            <Border Grid.Column="4" x:Name="BadgeBorder" CornerRadius="8" MinWidth="62"
                    Background="{DynamicResource PrimarySubtleBrush}"
                    Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ScaleText" Text="每行 5 个" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>