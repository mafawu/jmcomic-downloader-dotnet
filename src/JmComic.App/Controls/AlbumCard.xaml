<UserControl x:Class="JmComic.App.Controls.AlbumCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JmComic.App.Common"
             Margin="0,0,14,14"
             SizeChanged="Card_SizeChanged">
    <Border x:Name="Root" Style="{StaticResource CardHoverStyle}" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Cursor="Hand"
            MouseEnter="Root_MouseEnter"
            MouseLeave="Root_MouseLeave"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <StackPanel>
            <!-- 封面高度由代码按 166:222 宽高比随宽度自适应，保证任意窗口/分格大小下不变形 -->
            <Border x:Name="CoverHost" CornerRadius="14,14,0,0" ClipToBounds="True">
                <Grid>
                    <Border Background="{DynamicResource HoverBgBrush}" />
                    <Image common:ImageLoader.Source="{Binding CoverUrl}"
                           common:ImageLoader.Headers="{Binding ImageHeaders}"
                           Stretch="UniformToFill" />
                    <!-- 来源站点徽标（聚合搜索时显示） -->
                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="6"
                            Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="8,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SourceBadge}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SourceBadge}" FontSize="10" Foreground="White" />
                    </Border>
                    <Border x:Name="Overlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="一键下载"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding DownloadCommand}" />
                    </Border>
                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="999"
                            Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="已下载" FontSize="10" Foreground="White" />
                    </Border>
                </Grid>
            </Border>
            <StackPanel Margin="12,10,12,12" MinHeight="64">
                <TextBlock Text="{Binding Name}"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxHeight="38"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding AuthorText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
