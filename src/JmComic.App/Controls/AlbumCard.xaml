<UserControl x:Class="JmComic.App.Controls.AlbumCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JmComic.App.Common"
             Width="168" Margin="0,0,14,14">
    <Border x:Name="Root" Style="{StaticResource CardHoverStyle}" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            Cursor="Hand"
            MouseEnter="Root_MouseEnter"
            MouseLeave="Root_MouseLeave"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <StackPanel>
            <Grid Width="166" Height="222" ClipToBounds="True">
                <Border CornerRadius="14,14,0,0" Background="{DynamicResource HoverBgBrush}" />
                <Image common:ImageLoader.Source="{Binding CoverUrl}"
                       Width="166" Height="222"
                       Stretch="UniformToFill" />
                <Border x:Name="Overlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Content="一键下载"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding DownloadCommand}" />
                </Border>
                <Border Background="{DynamicResource SuccessBrush}" CornerRadius="999"
                        Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="已下载" FontSize="10" Foreground="White" />
                </Border>
            </Grid>
            <StackPanel Margin="12,10,12,12" Height="80">
                <TextBlock Text="{Binding Name}"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxHeight="38"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding AuthorText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,5,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
