<UserControl x:Class="JmComic.App.Controls.VideoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,0,14,14">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="14" Cursor="Hand"
            MouseLeftButtonUp="Card_Click">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- 封面区域 -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True" Background="{DynamicResource SkeletonBrush}">
                <Grid>
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    <Border x:Name="PlaceholderIcon" Background="{DynamicResource HoverBgBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" />
                            <TextBlock Text="暂无封面" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- 播放按钮 -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#B3000000" CornerRadius="24" Width="48" Height="48"
                            Visibility="Collapsed" x:Name="PlayOverlay">
                        <TextBlock Text="▶" FontSize="20" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- 文件数角标 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                            Background="#CC000000" CornerRadius="6" Padding="6,2">
                        <TextBlock x:Name="FileCountText" Text="0 个" FontSize="10" Foreground="White" FontWeight="Bold" />
                    </Border>
                    <!-- 进度条 -->
                    <Border VerticalAlignment="Bottom" Height="3" Background="#40000000">
                        <Border x:Name="ProgressBar" Background="{DynamicResource PrimaryBrush}"
                                HorizontalAlignment="Left" Width="0" />
                    </Border>
                </Grid>
            </Border>
            <!-- 信息区域 -->
            <StackPanel Grid.Row="1" Margin="10,10,10,12" MinHeight="64">
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SeriesText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="SizeText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="RatingText" FontSize="11" Foreground="#FFD700" Margin="8,0,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
                <ItemsControl x:Name="TagItems" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PrimarySubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="999" Padding="6,2" Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>