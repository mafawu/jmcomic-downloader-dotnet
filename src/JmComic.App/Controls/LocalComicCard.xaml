<UserControl x:Class="JmComic.App.Controls.LocalComicCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JmComic.App.Common"
             Margin="0,0,14,14"
             SizeChanged="Card_SizeChanged">
    <Grid x:Name="Root" Cursor="Hand" MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave" MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid.ToolTip>
            <ToolTip MaxWidth="380" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10">
                <StackPanel MaxWidth="360">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NameCn}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowNameCn}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PrimarySubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="6,2" Margin="0,0,4,4"><TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ToolTip>
        </Grid.ToolTip>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" MaxHeight="420">
            <StackPanel>
                <Border x:Name="CoverHost" CornerRadius="14,14,0,0" ClipToBounds="True" Background="{DynamicResource SkeletonBrush}">
                    <Grid>
                                                <Image common:ImageLoader.Source="{Binding CoverPath}" Stretch="UniformToFill" />
                        <Border x:Name="KindBadgeLocal" Background="{DynamicResource PrimaryBrush}" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"><TextBlock Text="漫" FontSize="10" Foreground="White" FontWeight="Bold"/></Border>
                        <!-- 多选框（仿 Green MediaCard multi-select） -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Background="#EEFFFFFF" CornerRadius="6" Padding="3" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectionMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </Border>
                        <!-- 底部进度条（仿 Green cardProgress） -->
                        <Border VerticalAlignment="Bottom" Height="3" Background="#40000000">
                            <Border Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Progress}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Border>
                        <Border x:Name="Overlay" Background="#66000000" Visibility="Collapsed" CornerRadius="14,14,0,0">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="{Binding ActualWidth, ElementName=Root}">
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="阅读" Command="{Binding OpenReaderCommand}" Padding="14,6" />
                                    <Button Style="{StaticResource GhostButtonStyle}" Content="打开目录" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" Padding="14,6" />
                                </StackPanel>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Margin="10,10,10,12" MinHeight="72">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" common:TextBlockExt.MaxLines="2" LineHeight="16" TextTrimming="CharacterEllipsis" MaxHeight="32" />
                    <TextBlock Text="{Binding NameCn}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" common:TextBlockExt.MaxLines="1" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="16">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowNameCn}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding DisplayTags}" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource PrimarySubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="6,2" Margin="0,0,4,4"><TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ReadInfo}" FontSize="10.5" Foreground="{DynamicResource PrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasReadInfo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding RatingText}" FontSize="11" Foreground="#FFD700" Margin="0,1,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasRating}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


