<UserControl x:Class="JmComic.App.Controls.LocalComicCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:JmComic.App.Common"
             Margin="0,0,14,14"
             SizeChanged="Card_SizeChanged">
    <Grid x:Name="Root" Style="{StaticResource CardLiftStyle}" Cursor="Hand"
          MouseEnter="Root_MouseEnter"
          MouseLeave="Root_MouseLeave"
          MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <!-- 专用光晕/背景层：无内容，hover 阴影只光栅化这一层，内容层保持清晰 -->
        <Border Style="{StaticResource CardHoverStyle}" CornerRadius="20" />
        <!-- 内容层：不挂任何 Effect -->
        <Border CornerRadius="20">
            <StackPanel>
            <!-- 封面高度由代码按 166:222 宽高比随宽度自适应，保证任意窗口/分格大小下不变形 -->
            <Border x:Name="CoverHost" CornerRadius="20,20,0,0" ClipToBounds="True">
                <Grid>
                    <Border Background="{DynamicResource HoverBgBrush}" />
                    <Image common:ImageLoader.Source="{Binding CoverPath}"
                           Stretch="UniformToFill" />
                    <Border x:Name="Overlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                        <!-- 自适应操作区：Viewbox 让按钮组随卡片宽度整体缩放（窄分格自动缩小，不挤出分格） -->
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 MaxWidth="{Binding ActualWidth, ElementName=Root}">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="阅读"
                                        Command="{Binding OpenReaderCommand}"
                                        Padding="14,6" />
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Content="打开目录"
                                        Margin="8,0,0,0"
                                        Command="{Binding OpenFolderCommand}"
                                        Padding="14,6" />
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <StackPanel Margin="13,11,13,13" MinHeight="64">
                <TextBlock Text="{Binding Name}"
                           FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" common:TextBlockExt.MaxLines="2" />
                <TextBlock Text="{Binding NameCn}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" common:TextBlockExt.MaxLines="2"
                           Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNameCn}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding DisplayTags}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ActiveNavBgBrush}"
                                    CornerRadius="6" Padding="6,2" Margin="0,0,4,4">
                                <TextBlock Text="{Binding}" FontSize="10"
                                           Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StatsText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
